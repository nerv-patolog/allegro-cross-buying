{
  "name": "allegro-seller-finder",
  "version": "0.0.1",
  "description": "Browser extension to find common sellers across Allegro products",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/svelte": "^4.2.3",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^4.2.20",
    "vite": "^5.4.11",
    "vite-plugin-web-extension": "^4.1.6",
    "vitest": "^2.1.8"
  }
}
